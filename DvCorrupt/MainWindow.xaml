<Window x:Class="DvCorrupt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DV Corrupt — tape deck error concealment" Width="1440" Height="920" MinWidth="1000" MinHeight="640"
        Background="{StaticResource Bg}" AllowDrop="True" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="390"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Border Grid.ColumnSpan="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel LastChildFill="False">
                <Button x:Name="OpenBtn" Content="Open video…" Click="Open_Click"/>
                <TextBlock Text="Preset" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource Dim}"/>
                <ComboBox x:Name="PresetBox" Width="210" VerticalAlignment="Center" SelectionChanged="Preset_Changed"/>
                <Button Content="Save preset…" Click="SavePreset_Click" Margin="8,0,6,0"/>
                <Button Content="Load preset…" Click="LoadPreset_Click"/>
                <TextBlock x:Name="FileText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
            </DockPanel>
        </Border>

        <!-- preview column -->
        <Grid Grid.Row="1" Margin="12,12,6,8">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="Black" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <Viewbox Stretch="Uniform">
                        <Image x:Name="Preview" Width="640" Height="480" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Viewbox>
                    <TextBlock x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Foreground="{StaticResource Dim}" FontSize="15" LineHeight="24">
                        Open (or drop) a MiniDV .avi, a P2 HVX200 .mxf, or a deinterlaced .mp4<LineBreak/>
                        <Run FontSize="12">16:9 sources are cropped to 4:3 automatically</Run>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- RF scope -->
            <Border Grid.Row="1" Margin="0,8,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#141210">
                <Image x:Name="ScopeImg" Height="96" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>
            <DockPanel Grid.Row="2" Margin="0,3,0,0" LastChildFill="False">
                <TextBlock FontSize="11" Foreground="{StaticResource Dim}">
                    <Run Text="RF envelope per head sweep (entrance ← → exit)  ·  "/>
                    <Run Foreground="#46C8EB" Text="■ head A"/>
                    <Run Text="  "/>
                    <Run Foreground="#F5A046" Text="■ head B"/>
                    <Run Text="  "/>
                    <Run Foreground="#F0DC3C" Text="┄ read threshold"/>
                    <Run Text="  "/>
                    <Run Foreground="#FF3232" Text="| lost video block"/>
                    <Run Text="  "/>
                    <Run Foreground="#E63CFF" Text="| lost audio block"/>
                </TextBlock>
                <TextBlock x:Name="StatsText" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource Dim}" FontFamily="Consolas"/>
            </DockPanel>

            <!-- transport -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BackBtn" Content="◀◀" ToolTip="Previous frame (←)" Click="Back_Click" Width="40"/>
                    <Button x:Name="PlayBtn" Content="▶  Play" ToolTip="Play / pause (Space)" Click="Play_Click" Width="86"/>
                    <Button x:Name="FwdBtn" Content="▶▶" ToolTip="Next frame (→)" Click="Fwd_Click" Width="40"/>
                </StackPanel>
                <Slider x:Name="SeekSlider" Grid.Column="1" VerticalAlignment="Center" Margin="8,0" Minimum="0" Maximum="1"
                        IsMoveToPointEnabled="True" IsSelectionRangeEnabled="True" ValueChanged="Seek_Changed" Focusable="False"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock x:Name="TimeText" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,10,0" Text="00:00:00;00"/>
                    <Button Content="In" ToolTip="Set export in-point (I)" Click="SetIn_Click"/>
                    <Button Content="Out" ToolTip="Set export out-point (O)" Click="SetOut_Click"/>
                    <Button Content="Clear" Click="ClearInOut_Click" Margin="0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- controls column -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                <StackPanel x:Name="ParamPanel">
                    <Expander Header="Source / output" IsExpanded="True">
                        <StackPanel Margin="4,4,0,0">
                            <TextBlock Text="Working size" Foreground="{StaticResource Dim}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="SizeBox" SelectionChanged="SourceOption_Changed"/>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="4:3 crop position" Foreground="{StaticResource Dim}"/>
                                <TextBlock x:Name="CropText" DockPanel.Dock="Right" HorizontalAlignment="Right" FontFamily="Consolas" Text="centre"/>
                            </DockPanel>
                            <Slider x:Name="CropSlider" Minimum="-1" Maximum="1" Value="0" ValueChanged="Crop_Changed" ToolTip="Pan the 4:3 window across a 16:9 source (double-click to centre)"/>
                            <CheckBox x:Name="DeintBox" Content="Deinterlace (bwdif)" Margin="0,6,0,0" Click="SourceOption_Changed"/>
                        </StackPanel>
                    </Expander>
                    <!-- glitch parameter groups are inserted here from code -->
                    <Expander x:Name="ExportExpander" Header="Export" IsExpanded="True">
                        <StackPanel Margin="4,4,0,0">
                            <ComboBox x:Name="CodecBox"/>
                            <CheckBox x:Name="AudioBox" Content="Include audio" IsChecked="True" Margin="0,6,0,0"/>
                            <CheckBox x:Name="AudioGlitchBox" Content="Audio errors follow the tape (mute / interpolate)" IsChecked="True" Margin="0,4,0,0"/>
                            <CheckBox x:Name="ReinterlaceBox" Content="Re-interlace 59.94p → 29.97i (field pairs)" IsChecked="True" Margin="0,4,0,0"
                                      Visibility="Collapsed" ToolTip="Weave each pair of deinterlaced frames back into one interlaced frame (TFF; DV export is always BFF 29.97i)."/>
                            <TextBlock x:Name="RangeText" Foreground="{StaticResource Dim}" Margin="0,6,0,0" Text="Range: whole file"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="ExportBtn" Content="Export…" Click="Export_Click"/>
                                <Button x:Name="CancelBtn" Content="Cancel" Click="Cancel_Click" IsEnabled="False"/>
                            </StackPanel>
                            <ProgressBar x:Name="ExportProgress" Height="6" Margin="0,8,0,0" Maximum="1" Background="#26262d" Foreground="{StaticResource Accent}" BorderThickness="0"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- status -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,4">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Dim}" FontSize="12" Text="Ready."/>
        </Border>
    </Grid>
</Window>
